generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

/* ─── Organization ─────────────────────────────────────────────────── */

model Organization {
  id        String   @id @default(cuid())

  /// The join key back to AltomateHR's own organization id. Identity is
  /// sourced from AltomateHR (mocked in `lib/altomatehr/`); this row is a
  /// local cache, not an authoritative account store.
  altomateOrgId String @unique
  name          String

  /// Encrypted (AES-256-GCM, see lib/altomatehr/token-crypto.ts) per-org
  /// wp_live_* AltomateHR API token, used only for GET /api/v1/employees —
  /// that endpoint has no master-token support, so a genuine per-org token
  /// is required. Null until provisioned (scripts/provision-org-token.ts);
  /// roster sync degrades to an empty list, not an error, when absent.
  altomateApiTokenEncrypted String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  users               User[]
  appraisals          Appraisal[]
  appraisalTemplates  AppraisalTemplate[]
}

/* ─── User ──────────────────────────────────────────────────────────── */

enum UserRole {
  EMPLOYEE
  SUPERVISOR
  ADMIN
  OWNER
}

model User {
  id             String   @id @default(cuid())
  organizationId String

  /// The join key back to AltomateHR's own user id. Every row exists
  /// because it was synced from AltomateHR (mocked) — there are no local
  /// credentials or locally-managed accounts.
  altomateUserId String   @unique
  email          String   @unique
  name           String
  role           UserRole @default(EMPLOYEE)

  /// Free-text job title, shown as "position" on the admin employees table
  /// and snapshotted onto `Appraisal.role` when a cycle starts. AltomateHR
  /// keeps this on a separate `EmployeeProfile` row; AppraisifyAlt has no
  /// equivalent module, so it lives directly on `User`.
  title String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  appraisalsAsReviewee Appraisal[] @relation("AppraisalReviewee")
  appraisalsAsReviewer Appraisal[] @relation("AppraisalReviewer")
  appraisalsAsPartner  Appraisal[] @relation("AppraisalPartner")
  appraisalsCreated    Appraisal[] @relation("AppraisalCreatedBy")

  notifications Notification[]

  @@index([organizationId])
}

/* ─── Notification (minimal — in-app inbox only, no web push/SSE) ───── */

enum NotificationType {
  APPRAISAL_PHASE_READY
  APPRAISAL_COMPLETED
}

model Notification {
  id             String           @id @default(cuid())
  userId         String
  organizationId String?
  type           NotificationType
  title          String
  body           String           @db.Text
  url            String?
  readAt         DateTime?
  createdAt      DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/* ─── Appraisify (performance appraisals) ────────────────────────────
   Ported verbatim from AltomateHR's feat/appraisify-module branch. A
   three-phase appraisal cycle: reviewee self-assessment → reviewer
   scoring → partner final scoring. Stage advances one step per phase
   submission (see `nextAppraisalStage` in the domain layer). */

enum AppraisalStage {
  INITIALIZED
  REVIEWER_PENDING
  PARTNER_PENDING
  SUBMITTED
}

enum AppraisalType {
  ANNUAL
  MID_YEAR
  PROBATION
}

model Appraisal {
  id              String         @id @default(cuid())
  organizationId  String
  referenceNumber String         @unique
  stage           AppraisalStage @default(INITIALIZED)
  year            Int
  type            AppraisalType  @default(ANNUAL)
  /// Snapshot of the reviewee's team/department and job title at creation
  /// time, so historical appraisals don't change if the employee moves.
  team            String?
  role            String?

  revieweeId      String
  reviewerId      String
  partnerId       String
  createdByUserId String

  /// Per-phase section free-text (Goals Review / Overall Remarks /
  /// Development Plans), one set per phase.
  revieweeGoals       String? @db.Text
  revieweeRemarks     String? @db.Text
  revieweeDevelopment String? @db.Text
  reviewerGoals       String? @db.Text
  reviewerRemarks     String? @db.Text
  reviewerDevelopment String? @db.Text
  partnerGoals        String? @db.Text
  partnerRemarks      String? @db.Text
  partnerDevelopment  String? @db.Text

  revieweeSubmittedAt DateTime?
  reviewerSubmittedAt DateTime?
  partnerSubmittedAt  DateTime?

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reviewee     User                @relation("AppraisalReviewee", fields: [revieweeId], references: [id], onDelete: Cascade)
  reviewer     User                @relation("AppraisalReviewer", fields: [reviewerId], references: [id])
  partner      User                @relation("AppraisalPartner", fields: [partnerId], references: [id])
  createdBy    User                @relation("AppraisalCreatedBy", fields: [createdByUserId], references: [id])
  questions    AppraisalQuestion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, year])
  @@index([revieweeId])
  @@index([reviewerId], map: "Appraisal_reviewerId_fkey")
  @@index([partnerId], map: "Appraisal_partnerId_fkey")
  @@index([createdByUserId], map: "Appraisal_createdByUserId_fkey")
}

model AppraisalQuestion {
  id          String  @id @default(cuid())
  appraisalId String
  order       Int
  /// Section key used to group questions into the tabbed UI.
  section     String?
  text        String  @db.Text
  description String? @db.Text

  /// Scores are 1–5 with up to 2 decimal places.
  revieweeScore   Decimal? @db.Decimal(4, 2)
  revieweeComment String?  @db.Text
  reviewerScore   Decimal? @db.Decimal(4, 2)
  reviewerComment String?  @db.Text
  partnerScore    Decimal? @db.Decimal(4, 2)
  partnerComment  String?  @db.Text

  appraisal Appraisal @relation(fields: [appraisalId], references: [id], onDelete: Cascade)

  @@index([appraisalId, order])
}

/// A reusable, admin-authored question set. When an appraisal is started the
/// chosen template's questions are *snapshotted* into AppraisalQuestion rows,
/// so editing a template later never changes existing appraisals.
model AppraisalTemplate {
  id             String  @id @default(cuid())
  organizationId String
  name           String
  archived       Boolean @default(false)

  organization Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  questions    AppraisalTemplateQuestion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
}

model AppraisalTemplateQuestion {
  id          String  @id @default(cuid())
  templateId  String
  order       Int
  section     String?
  text        String  @db.Text
  description String? @db.Text

  template AppraisalTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId, order])
}
